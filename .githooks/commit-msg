#!/usr/bin/env bash
set -euo pipefail

message="$(head -n 1 "$1")"
if [[ "$message" =~ ^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?:\ .+ ]]; then
  exit 0
fi

printf '%s\n' \
  "Invalid commit message: $message" \
  "Use a conventional commit, for example: feat(cli): describe contracts" >&2
exit 1
